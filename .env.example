# yarn chain and yarn verify:network load .env automatically.
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WALLET_ADDRESS=0x1Dda4b932633cAd2a182f444bd5DE39BB01c278A

# Only needed for transaction preview/sending. Use a dedicated testnet wallet.
# Put the key here locally, never in chat. This file's .env copy is gitignored.
PRIVATE_KEY=

# Optional: leave blank to use the deployment saved by yarn chain deploy.
# ORDIN_ADDRESS=0x...

# Frame UI defaults to Whitechain: yarn frame. Optional sandbox: yarn frame:local.
# Locally, the saved .ordin/sepolia.json is also accepted. Hosting must set ORDIN_ADDRESS.
MERCHANT_PRIVATE_KEY=
MERCHANT_TREASURY=
FRAME_PORT=3210
# FRAME_HOST=127.0.0.1
# FRAME_ORIGIN=https://your-frame-site.example
# FRAME_DATABASE=.ordin/frame.sqlite
RELAYER_DAILY_GAS_BUDGET_WBT=0.05

# Optional dedicated protocol deployer; yarn deploy:testnet uses this before PRIVATE_KEY.
DEPLOYER_PRIVATE_KEY=
