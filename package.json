{
  "name": "ordin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node --import tsx scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "test": "yarn compile && node --import tsx --test test/*.test.ts",
    "demo": "yarn compile && node --import tsx scripts/demo.ts",
    "verify:network": "node --import tsx scripts/verify-network.ts",
    "chain": "node --import tsx scripts/chain.ts",
    "frame": "node --import tsx services/merchant/server.ts --whitechain",
    "frame:whitechain": "node --import tsx services/merchant/server.ts --whitechain",
    "frame:local": "yarn compile && node --import tsx services/merchant/server.ts --local",
    "start": "node --import tsx services/merchant/server.ts --whitechain",
    "frame:check": "node --import tsx scripts/frame-preflight.ts",
    "frame:deploy": "yarn deploy:testnet",
    "frame:host-secrets": "node --import tsx scripts/frame-host-secrets.ts",
    "deploy:testnet": "yarn compile && node --import tsx scripts/frame-deploy.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "hardhat": "3.12.0",
    "solc": "0.8.30",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@1.22.22"
}
